{
  "manifest_version": 3,
  "name": "LinkTunnel",
  "description": "Viser hvor et link går hen, før du åbner det – og advarer, hvis det ligner svindel.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["linktunnel-core.js", "content.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "32": "toolbar-32.png",
      "48": "icon-48.png"
    }
  },
  "permissions": ["nativeMessaging", "storage"]
}
